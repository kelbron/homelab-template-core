# Local environment and secret overrides
.env
*.env
secrets/
*.secret.yaml

# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (contain sensitive keys/PATs)
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files
.terraform.tfstate.lock.info

# Ignore plan files
*tfplan*
planout

# Python compilation and test cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# workstation setup sentinel file
.setup_done
