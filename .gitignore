# Local environment and secret overrides
.env
*.env
secrets/
*.secret.yaml

# System and editor files
.DS_Store
*.swp
*~

# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files
.terraform.tfstate.lock.info

# Ignore plan files
*tfplan*
planout

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Visual Studio Code
.vscode/*
!*.code-workspace

# Built Visual Studio Code Extensions
*.vsix

# Python compilation and test cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# workstation setup sentinel file
.setup_done
