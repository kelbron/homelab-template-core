#!/usr/bin/env bash
# githooks/pre-commit.d/03-enforce-branch-naming
# Enforces conventional branch names locally on workstation prior to commits.

set -euo pipefail

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "HEAD")

# Bypass verification for trunk branches, release preparation, or detached HEAD states
if [ "$CURRENT_BRANCH" = "main" ] || \
   [ "$CURRENT_BRANCH" = "master" ] || \
   [ "$CURRENT_BRANCH" = "develop" ] || \
   [ "$CURRENT_BRANCH" = "HEAD" ]; then
    exit 0
fi

# Verify the branch starts with a conventional prefix type
# Valid prefix types: feat/, feature/, bugfix/, fix/, hotfix/, chore/, release/, ai/, claude/, cursor/
if [[ ! "$CURRENT_BRANCH" =~ ^(feat|feature|bugfix|fix|hotfix|chore|release|ai|claude|cursor|copilot)/ ]]; then
    echo "===============================================================================" >&2
    echo "❌ [Git Hook Error] Commit blocked due to invalid branch name!" >&2
    echo "===============================================================================" >&2
    echo "Current branch name: '$CURRENT_BRANCH'" >&2
    echo "👉 Your local branch name must adhere to our Conventional Branch Naming rules." >&2
    echo "   " >&2
    echo "   Allowed Naming Conventions:" >&2
    echo "     <type>/[optional-ticket-id-]<short-hyphenated-description>" >&2
    echo "   " >&2
    echo "   Examples of Valid Branches:" >&2
    echo "     - feat/AB102-kustomize-ingress-domains" >&2
    echo "     - fix/issue-4-shellcheck-traefik-quoting" >&2
    echo "     - chore/update-keepass-backup-cron" >&2
    echo "===============================================================================" >&2
    exit 1
fi
