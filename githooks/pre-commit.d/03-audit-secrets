#!/usr/bin/env bash
# templates/githooks/pre-commit.d/03-audit-secrets
# Central compliance task to execute workstation Secret Leak audits.

set -euo pipefail

# Force safe system fallback locales
export LANG=C.UTF-8
export LC_ALL=C.UTF-8

REPO_ROOT="$(git rev-parse --show-toplevel)"
AUDIT_SCRIPT="${REPO_ROOT}/scripts/workstation/audit-repo-secrets.sh"

if [ -f "$AUDIT_SCRIPT" ]; then
    chmod +x "$AUDIT_SCRIPT"
    "$AUDIT_SCRIPT"
else
    echo "⚠️  Workstation audit script not found at $AUDIT_SCRIPT. Skipping Secret Leak validation."
fi
